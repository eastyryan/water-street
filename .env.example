# Postgres connection string. With Supabase: Project > Connect > "Transaction pooler" URI.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional. The app makes and stores its own cookie-signing secret; set this only
# if you would rather manage it yourself (openssl rand -base64 48).
# SESSION_SECRET=
